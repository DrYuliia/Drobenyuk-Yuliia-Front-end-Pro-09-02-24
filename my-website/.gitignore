.npm/

# Optional eslint cache

.eslintcache

# Optional REPL history

.node_repl_history

# Logs

logs/
_.log
npm-debug.log_
yarn-debug.log*
yarn-error.log*

# Runtime data

pids/
_.pid
_.seed
\*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover

lib-cov/

# Coverage directory used by tools like istanbul

coverage/

# nyc test coverage

.nyc_output/

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)

.grunt/

# Bower dependency directory (https://bower.io/)

bower_components/

# Environment variable files

.env
.env.test
.env.production

# Cache and history files

.cache
.history

# Directory for garbage files from various editors/IDEs

.vscode/
.idea/
_.swp
_.swo
\*.swn
.DS_Store

# Compiled CSS files (optional, if you want to keep your CSS files in the repo)

dist/css/main.min.css

# Compiled JS files (optional, if you want to keep your JS files in the repo)

dist/js/main.min.js
